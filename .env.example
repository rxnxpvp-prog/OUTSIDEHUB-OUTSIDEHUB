# Discord OAuth configuration
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3333/api/auth/discord/callback
CLIENT_URL=http://localhost:5173

# Backend server port
PORT=3333

# Optional provider credentials used by scraper integrations
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# SMSRush API
SMSRUSH_BASE_URL=https://example.com
SMSRUSH_EMAIL=
SMSRUSH_PASSWORD=

# Admin Search / Leaks OSINT
# GITHUB_TOKEN enables deep GitHub code search metadata.
# HIBP_API_KEY enables Have I Been Pwned breach metadata for emails.
GITHUB_TOKEN=
HIBP_API_KEY=
INTELX_API_KEY=
INTELX_API_KEYS=
INTELX_ROTATION_HOURS=48
INTELX_SEARCH_BASE_URL=https://2.intelx.io
INTELX_LEAKS_BASE_URL=https://3.intelx.io
