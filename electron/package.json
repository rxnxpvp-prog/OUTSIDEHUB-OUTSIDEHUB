{
  "name": "outsidehub-desktop",
  "productName": "OutsideHub",
  "version": "1.0.5",
  "description": "OutsideHub desktop shell",
  "main": "main.cjs",
  "author": "OutsideHub",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.outsidehub.desktop",
    "productName": "OutsideHub",
    "directories": {
      "output": "../release"
    },
    "asar": false,
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist"
      },
      {
        "from": "../outsidehub.ico",
        "to": "outsidehub.ico"
      }
    ],
    "extraMetadata": {
      "main": "main.cjs"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OutsideHub"
    }
  }
}
